<Window x:Class="QureMed.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid x:Name="Root" RequestedTheme="Dark" Background="#0B101A" Loaded="Root_Loaded">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="18,10" BorderThickness="0,0,0,1" BorderBrush="#253044">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="RehaFlow" FontSize="19" Foreground="#79E1C0" VerticalAlignment="Center"/>
      <TextBox x:Name="Address" Grid.Column="1" PlaceholderText="https://192.168.1.100" AutomationProperties.Name="Адреса сервера" KeyDown="Address_KeyDown"/>
      <Button x:Name="ConnectButton" Grid.Column="2" Content="Підключитися" Click="Connect_Click"/>
      <Button Grid.Column="3" Content="Оновити" Click="Reload_Click"/>
    </Grid>
  </Border>
  <Grid x:Name="BrowserHost" Grid.Row="1"/>
  <Grid x:Name="ConnectionScreen" Grid.Row="1" Background="#0B101A">
    <StackPanel Width="480" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Padding="24">
      <TextBlock Text="QUREMED INDUSTRIES" Foreground="#79E1C0" FontSize="14"/>
      <TextBlock Text="Ваш центр.&#x0a;Єдиний робочий простір." FontSize="36" TextWrapping="Wrap"/>
      <TextBlock x:Name="StatusText" Text="Вкажіть адресу локального сервера та підключіться." FontSize="16" Foreground="#A8B8CA" TextWrapping="Wrap"/>
      <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
      <Button x:Name="RuntimeButton" Content="Встановити Microsoft Edge WebView2" Visibility="Collapsed" Click="Runtime_Click"/>
    </StackPanel>
  </Grid>
  <Border x:Name="ShellFooter" Grid.Row="2" BorderBrush="#253044" BorderThickness="0,1,0,0" Padding="18,10"><TextBlock Text="сервери QureMed Industries" Foreground="#94A2B8" FontSize="12"/></Border>
</Grid>
</Window>
