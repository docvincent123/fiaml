# Setup-Local.ps1 generates .env with random credentials. Never commit .env.
DB_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-12-or-more-characters
PUBLIC_URL=https://192.168.1.100
# Development without Docker (set environment variables, not this example):
# DATABASE_URL=postgres://quremed:password@localhost:5432/quremed
# HOST=127.0.0.1
# PORT=3000
